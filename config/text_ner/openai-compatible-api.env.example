# Copy this file to the repository root as .env, then set the real API key.
# The runtime parser accepts only these five TEXT_NER_* keys.
TEXT_NER_API_KEY=
TEXT_NER_BASE_URL=https://api.deepseek.com
TEXT_NER_MODEL=deepseek-v4-flash
TEXT_NER_MODEL_VERSION=DeepSeek-V4-Flash
TEXT_NER_PROVIDER=deepseek
