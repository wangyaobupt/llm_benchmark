{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mcq-investigation-rule/1.0.0",
  "title": "ConditionalInvestigationRule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "rule_version", "rule_id", "comparison_class",
    "condition_feature_ids", "condition_display_names",
    "target_investigation_id", "target_investigation_name",
    "n_total", "n_x", "n_y", "n_xy",
    "conditional_probability", "smoothed_probability", "baseline_probability",
    "lift", "wilson_lower", "fisher_p", "fdr_q", "bootstrap_stability", "score",
    "runner_up_investigation_id", "runner_up_probability",
    "probability_gap", "score_ratio", "status", "rejection_reasons"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "rule_version": { "const": "1.0.0" },
    "rule_id": { "type": "string", "pattern": "^rule_[0-9a-f]{24}$" },
    "comparison_class": { "enum": ["imaging", "clinical_order", "laboratory"] },
    "condition_feature_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "condition_display_names": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "target_investigation_id": { "type": "string", "pattern": "^cand_[0-9a-f]{24}$" },
    "target_investigation_name": { "type": "string", "minLength": 1 },
    "n_total": { "type": "integer", "minimum": 0 },
    "n_x": { "type": "integer", "minimum": 0 },
    "n_y": { "type": "integer", "minimum": 0 },
    "n_xy": { "type": "integer", "minimum": 0 },
    "conditional_probability": { "type": "number", "minimum": 0, "maximum": 1 },
    "smoothed_probability": { "type": "number", "minimum": 0, "maximum": 1 },
    "baseline_probability": { "type": "number", "minimum": 0, "maximum": 1 },
    "lift": { "type": "number", "minimum": 0 },
    "wilson_lower": { "type": "number", "minimum": 0, "maximum": 1 },
    "fisher_p": { "type": "number", "minimum": 0, "maximum": 1 },
    "fdr_q": { "type": "number", "minimum": 0, "maximum": 1 },
    "bootstrap_stability": { "type": "number", "minimum": 0, "maximum": 1 },
    "score": { "type": "number", "minimum": 0 },
    "runner_up_investigation_id": { "type": ["string", "null"], "pattern": "^(cand_[0-9a-f]{24}|)$" },
    "runner_up_probability": { "type": ["number", "null"], "minimum": 0 },
    "probability_gap": { "type": ["number", "null"], "minimum": 0 },
    "score_ratio": { "type": ["number", "null"], "minimum": 0 },
    "status": { "enum": ["accepted", "rejected"] },
    "rejection_reasons": {
      "type": "array",
      "items": {
        "enum": [
          "low_x_support", "low_xy_support", "low_conditional_probability",
          "low_lift", "low_wilson_lower", "fdr_not_significant",
          "low_bootstrap_stability", "ambiguous_probability_gap",
          "ambiguous_score_ratio"
        ]
      },
      "uniqueItems": true
    }
  }
}
