{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-benchmark.local/schemas/clinical-event/1.2.0",
  "title": "ClinicalEvent with embedded primary ClinicalEntity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "cleaning_status", "event_id", "entity_id", "source_row_id",
    "subject_id", "hadm_id", "encounter_id", "event_kind",
    "lifecycle_action", "status", "assertion", "event_time",
    "source_available_time", "available_time", "recorded_time", "time_resolution_status",
    "time_precision", "time_policy_id", "time_resolution_reasons",
    "evidence_phase", "source_concept_id", "concept_id", "preferred_name",
    "source_label", "entity_type", "normalization_status",
    "terminology_mapping_version", "content_specificity", "value_numeric",
    "value_text", "value_structured_json", "unit", "abnormal_flag",
    "normalized_value_numeric", "normalized_value_text", "normalized_unit",
    "unit_normalization_status",
    "source_module", "source_table", "source_array_index",
    "jsonl_line_number", "raw_row_ref", "source_action", "quality_flags",
    "supporting_source_row_ids", "supporting_raw_row_refs"
  ],
  "properties": {
    "schema_version": {"const": "1.2.0"},
    "cleaning_status": {"const": "accepted"},
    "event_id": {"type": "string", "pattern": "^evt:[0-9a-f]{24}$"},
    "entity_id": {"type": ["string", "null"], "pattern": "^ent:[0-9a-f]{24}$"},
    "source_row_id": {"type": "string", "pattern": "^src:[0-9a-f]{24}$"},
    "subject_id": {"type": "string", "minLength": 1},
    "hadm_id": {"type": "string", "minLength": 1},
    "encounter_id": {"type": "string", "minLength": 1},
    "event_kind": {
      "enum": [
        "symptom_reported", "vital_measured", "triage_acuity_recorded",
        "laboratory_ordered", "imaging_ordered", "medication_ordered",
        "clinical_ordered", "laboratory_resulted", "microbiology_resulted",
        "medication_administered", "medication_not_administered",
        "medication_administration_documented", "service_changed",
        "patient_transferred", "condition_recorded_post_hoc",
        "procedure_recorded_post_hoc", "administrative_group_recorded",
        "clinical_datetime_recorded", "medication_ingredient_administered",
        "input_administered", "output_measured", "procedure_performed",
        "medication_reconciled", "medication_dispensed", "medication_order_status_recorded", "imaging_reported",
        "document_recorded"
      ]
    },
    "lifecycle_action": {"type": ["string", "null"]},
    "status": {"type": ["string", "null"]},
    "assertion": {"enum": ["present", "absent", "possible", "unknown", "not_applicable"]},
    "event_time": {"$ref": "#/$defs/timeOrNull"},
    "source_available_time": {"$ref": "#/$defs/timeOrNull"},
    "available_time": {"$ref": "#/$defs/timeOrNull"},
    "recorded_time": {"$ref": "#/$defs/timeOrNull"},
    "time_resolution_status": {"enum": ["resolved", "partially_resolved", "unresolved"]},
    "time_precision": {"enum": ["subsecond", "second", "date", "unknown"]},
    "time_policy_id": {"type": "string", "minLength": 1},
    "time_resolution_reasons": {
      "type": "array",
      "items": {
        "enum": [
          "source_available_precedes_event_time",
          "completion_time_lower_bound",
          "event_time_lower_bound"
        ]
      },
      "uniqueItems": true
    },
    "evidence_phase": {"enum": ["source_event", "post_hoc", "administrative_end"]},
    "source_concept_id": {"type": ["string", "null"]},
    "concept_id": {"type": ["string", "null"]},
    "preferred_name": {"type": ["string", "null"]},
    "source_label": {"type": ["string", "null"]},
    "entity_type": {"type": ["string", "null"]},
    "normalization_status": {"enum": ["mapped", "unresolved", "not_applicable", null]},
    "terminology_mapping_version": {"type": ["string", "null"]},
    "content_specificity": {"enum": ["entity_specific", "attribute_enriched", "subtype_only", "category_only", "not_applicable"]},
    "value_numeric": {"type": ["number", "null"]},
    "value_text": {"type": ["string", "null"]},
    "value_structured_json": {"type": ["string", "null"]},
    "unit": {"type": ["string", "null"]},
    "abnormal_flag": {"type": ["string", "null"]},
    "normalized_value_numeric": {"type": ["number", "null"]},
    "normalized_value_text": {"type": ["string", "null"]},
    "normalized_unit": {"type": ["string", "null"]},
    "unit_normalization_status": {"enum": ["mapped", "unresolved", "not_applicable", null]},
    "source_module": {"enum": ["mimic_iv_hosp", "mimic_iv_icu", "mimic_iv_ed", "mimic_iv_note"]},
    "source_table": {"type": "string", "pattern": "^(hosp|icu|ed|note)\\.[a-z_]+$"},
    "source_array_index": {"type": "integer", "minimum": 0},
    "jsonl_line_number": {"type": "integer", "minimum": 1},
    "raw_row_ref": {"type": "string", "minLength": 1},
    "source_action": {"type": ["string", "null"]},
    "quality_flags": {
      "type": "array",
      "items": {
        "enum": [
          "AMBIGUOUS_MEDICATION_PAIRING",
          "AVAILABLE_BEFORE_EVENT_TIME",
          "AVAILABLE_TIME_DERIVED_FROM_COMPLETION",
          "AVAILABLE_TIME_CLAMPED_TO_EVENT_TIME",
          "AVAILABLE_TIME_UNKNOWN",
          "CATEGORY_ONLY_NO_SPECIFIC_ORDER_CONTENT",
          "CHANGE_WITHOUT_OBSERVABLE_DELTA",
          "MEDICATION_LABEL_RESOLVED_FROM_LINKED_SOURCE",
          "MISSING_TRANSACTION_TYPE",
          "NONRECIPROCAL_PREDECESSOR_LINK",
          "NONRECIPROCAL_SUCCESSOR_LINK",
          "OFFICIAL_TRANSACTION_SEMANTICS_UNRESOLVED",
          "ORDER_TIME_UNRESOLVED",
          "PHARMACY_POE_ID_CONFLICT",
          "POE_ACTION_UNINTERPRETED",
          "POE_ID_FORMAT_MISMATCH",
          "PREDECESSOR_CATEGORY_MISMATCH",
          "PREDECESSOR_TIME_AFTER_CURRENT_EVENT",
          "RELATION_CYCLE",
          "SUCCESSOR_CATEGORY_MISMATCH",
          "SUCCESSOR_TIME_BEFORE_CURRENT_EVENT",
          "TIME_UNAVAILABLE_IN_SOURCE",
          "UNKNOWN_TRANSACTION_TYPE",
          "UNMAPPED_DETAIL_FIELD",
          "UNRESOLVED_PHARMACY_ID",
          "UNRESOLVED_POE_ID",
          "UNRESOLVED_PREDECESSOR",
          "UNRESOLVED_SUCCESSOR"
        ]
      },
      "uniqueItems": true
    },
    "supporting_source_row_ids": {"type": "array", "items": {"type": "string", "pattern": "^src:[0-9a-f]{24}$"}, "uniqueItems": true},
    "supporting_raw_row_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "$defs": {
    "timeOrNull": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?)?$"}
      ]
    }
  }
}
