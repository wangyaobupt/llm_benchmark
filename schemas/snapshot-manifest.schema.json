{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-benchmark.local/schemas/snapshot-manifest/1.1.0",
  "title": "Decision snapshot visibility manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "lineage_status", "index_time", "policy_sha256", "counts", "events",
    "snapshot_sha256"
  ],
  "properties": {
    "schema_version": {"const": "snapshot-manifest/1.1.0"},
    "lineage_status": {"enum": ["generic_unverified", "boundary_authenticated"]},
    "index_time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}$"
    },
    "policy_sha256": {"$ref": "#/$defs/sha256"},
    "source_lineage": {"$ref": "#/$defs/sourceLineage"},
    "snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "snapshot_hmac_sha256": {"$ref": "#/$defs/sha256"},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "visible", "excluded", "exclusion_reason_counts"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "visible": {"type": "integer", "minimum": 0},
        "excluded": {"type": "integer", "minimum": 0},
        "exclusion_reason_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "SNAPSHOT_NOT_YET_OCCURRED", "SNAPSHOT_NOT_YET_AVAILABLE",
            "SNAPSHOT_TIME_UNKNOWN", "SNAPSHOT_POST_HOC",
            "SNAPSHOT_ADMINISTRATIVE_END", "SNAPSHOT_FIELD_NOT_ALLOWED",
            "SNAPSHOT_SPLIT_FORBIDDEN", "SNAPSHOT_SEMANTIC_LEAKAGE",
            "SNAPSHOT_IDENTITY_LEAKAGE"
          ],
          "properties": {
            "SNAPSHOT_NOT_YET_OCCURRED": {"type": "integer", "minimum": 0},
            "SNAPSHOT_NOT_YET_AVAILABLE": {"type": "integer", "minimum": 0},
            "SNAPSHOT_TIME_UNKNOWN": {"type": "integer", "minimum": 0},
            "SNAPSHOT_POST_HOC": {"type": "integer", "minimum": 0},
            "SNAPSHOT_ADMINISTRATIVE_END": {"type": "integer", "minimum": 0},
            "SNAPSHOT_FIELD_NOT_ALLOWED": {"type": "integer", "minimum": 0},
            "SNAPSHOT_SPLIT_FORBIDDEN": {"type": "integer", "minimum": 0},
            "SNAPSHOT_SEMANTIC_LEAKAGE": {"type": "integer", "minimum": 0},
            "SNAPSHOT_IDENTITY_LEAKAGE": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {"$ref": "#/$defs/eventDecision"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"lineage_status": {"const": "boundary_authenticated"}}, "required": ["lineage_status"]},
      "then": {"required": ["source_lineage", "snapshot_hmac_sha256"]}
    },
    {
      "if": {"properties": {"lineage_status": {"const": "generic_unverified"}}, "required": ["lineage_status"]},
      "then": {
        "not": {
          "anyOf": [
            {"required": ["source_lineage"]},
            {"required": ["snapshot_hmac_sha256"]}
          ]
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_lock_sha256", "subject_split_manifest_sha256", "encounter_boundary_manifest_sha256", "encounter_boundary_manifest_hmac_sha256", "boundary_source_inputs_sha256", "boundary_reference_key_id", "journey_id", "subject_role", "permitted_use"],
      "properties": {
        "protocol_lock_sha256": {"$ref": "#/$defs/sha256"},
        "subject_split_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "encounter_boundary_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "encounter_boundary_manifest_hmac_sha256": {"$ref": "#/$defs/sha256"},
        "boundary_source_inputs_sha256": {"$ref": "#/$defs/sha256"},
        "boundary_reference_key_id": {"type": "string", "minLength": 1},
        "journey_id": {"type": "string", "pattern": "^journey_[0-9a-f]{64}$"},
        "subject_role": {"enum": ["development", "validation", "final_test", "engineering_audit"]},
        "permitted_use": {"enum": ["rule_discovery", "threshold_validation", "blind_final_evaluation", "engineering_audit_only"]}
      }
    },
    "reasonCode": {
      "enum": [
        "SNAPSHOT_NOT_YET_OCCURRED", "SNAPSHOT_NOT_YET_AVAILABLE",
        "SNAPSHOT_TIME_UNKNOWN", "SNAPSHOT_POST_HOC",
        "SNAPSHOT_ADMINISTRATIVE_END", "SNAPSHOT_FIELD_NOT_ALLOWED",
        "SNAPSHOT_SPLIT_FORBIDDEN", "SNAPSHOT_SEMANTIC_LEAKAGE",
        "SNAPSHOT_IDENTITY_LEAKAGE"
      ]
    },
    "eventDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id", "source_event_sha256", "visibility_status",
        "exclusion_reason_codes", "visible_evidence"
      ],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "source_event_sha256": {"$ref": "#/$defs/sha256"},
        "visibility_status": {"enum": ["visible", "excluded"]},
        "exclusion_reason_codes": {
          "type": "array",
          "items": {"$ref": "#/$defs/reasonCode"},
          "uniqueItems": true
        },
        "visible_evidence": {"type": ["object", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"visibility_status": {"const": "visible"}}},
          "then": {
            "properties": {
              "exclusion_reason_codes": {"maxItems": 0},
              "visible_evidence": {"type": "object"}
            }
          }
        },
        {
          "if": {"properties": {"visibility_status": {"const": "excluded"}}},
          "then": {
            "properties": {
              "exclusion_reason_codes": {"minItems": 1},
              "visible_evidence": {"type": "null"}
            }
          }
        }
      ]
    }
  }
}
