# 项目级环境变量总览；包含多个子系统的变量，不能整体传给严格的 NER --env-file。
# NER 请复制 config/text_ner/openai-compatible-api.env.example 为 .env。
# .env 已在 .gitignore 中，不会提交。
DEEPSEEK_API_KEY=sk-your-key-here

# Text NER DeepSeek settings are for synthetic or public non-clinical tests only.
# Restricted MIMIC text is blocked from external API transfer by code and policy.
TEXT_NER_DEEPSEEK_API_KEY=
TEXT_NER_DEEPSEEK_BASE_URL=https://api.deepseek.com
TEXT_NER_DEEPSEEK_MODEL=deepseek-v4-flash
TEXT_NER_DEEPSEEK_MODEL_REVISION=DeepSeek-V4-Flash

# Provider-neutral OpenAI-compatible endpoint. The NER-specific example file
# contains only these five keys for `run-openai-compatible-api --env-file .env`.
# Process environment variables with the same names override this file.
# Runtime still requires the explicit execution and data-transfer gates.
TEXT_NER_API_KEY=
TEXT_NER_BASE_URL=https://api.deepseek.com
TEXT_NER_MODEL=deepseek-v4-flash
TEXT_NER_MODEL_VERSION=DeepSeek-V4-Flash
TEXT_NER_PROVIDER=deepseek

# Visit-row DS NER (data_pipeline/mcq_visit_ner). Separate from TEXT_NER_*.
# Restricted MIMIC text is not sent unless CLI gates and APPROVED=YES are set.
# Copy the key only into local .env; never paste it into chat.
MCQ_VISIT_NER_API_KEY=
MCQ_VISIT_NER_BASE_URL=https://www.dmxapi.cn/v1
MCQ_VISIT_NER_MODEL=deepseek-v4-flash
MCQ_VISIT_NER_MODEL_VERSION=DeepSeek-V4-Flash
MCQ_VISIT_NER_PROVIDER=openai-compatible
MCQ_VISIT_NER_EXTERNAL_API_APPROVED=
