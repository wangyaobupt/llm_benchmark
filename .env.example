# 复制本文件为 .env，填入真实 API key
# .env 已在 .gitignore 中，不会提交
DEEPSEEK_API_KEY=sk-your-key-here

# Text NER DeepSeek settings are for synthetic or public non-clinical tests only.
# Restricted MIMIC text is blocked from external API transfer by code and policy.
TEXT_NER_DEEPSEEK_API_KEY=
TEXT_NER_DEEPSEEK_BASE_URL=https://api.deepseek.com
TEXT_NER_DEEPSEEK_MODEL=deepseek-v4-flash
TEXT_NER_DEEPSEEK_MODEL_REVISION=DeepSeek-V4-Flash

# Provider-neutral OpenAI-compatible endpoint. This can point to a local server
# or an externally approved API. Runtime requires an explicit execution gate.
TEXT_NER_API_KEY=
TEXT_NER_BASE_URL=
TEXT_NER_MODEL=
TEXT_NER_MODEL_VERSION=
TEXT_NER_PROVIDER=openai-compatible
